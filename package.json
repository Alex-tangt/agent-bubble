{
  "name": "agent-bubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "host:start": "node scripts/local-backend.mjs start",
    "host:stop": "node scripts/local-backend.mjs stop",
    "host:status": "node scripts/local-backend.mjs status",
    "host:logs": "node scripts/local-backend.mjs logs",
    "test:host": "node --test scripts/tests/backend-readiness.test.mjs scripts/tests/local-backend.test.mjs",
    "test": "node --import tsx --test server/tests/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/smoke-live.ts",
    "test:articles": "node --env-file-if-exists=.env --import tsx scripts/test-articles-live.ts",
    "test:videos": "node --env-file-if-exists=.env --import tsx scripts/test-videos-live.ts",
    "test:qwen": "node --env-file-if-exists=.env --import tsx scripts/test-qwen-asr-live.ts",
    "browser:setup": "node --env-file-if-exists=.env --import tsx scripts/article-browser-setup.ts",
    "browser:login": "node --env-file-if-exists=.env --import tsx scripts/article-browser-login.ts",
    "bilibili:login": "node --env-file-if-exists=.env --import tsx scripts/bilibili-login.ts",
    "browser:install-electron": "node --use-env-proxy node_modules/electron/install.js",
    "test:browser-login": "node --import tsx scripts/test-browser-login-live.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@mozilla/readability": "0.6.0",
    "electron": "44.7.0",
    "fastify": "^5.6.0",
    "jsdom": "^27.0.0",
    "playwright": "1.62.1",
    "typebox": "1.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "description": "Android floating reading assistant with a personal-host agent backend",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-tangt/agent-bubble.git"
  },
  "homepage": "https://github.com/Alex-tangt/agent-bubble#readme"
}
