DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Required: generate your own random token (at least 24 characters).
AGENT_BUBBLE_TOKEN=
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
YTDLP_COMMAND=yt-dlp
# Optional: a Netscape cookies.txt file for your own Bilibili account.
BILIBILI_COOKIES_FILE=
# Project login: npm run bilibili:login; defaults to DATA_DIR/bilibili-cookies.txt.
# Independent conversations may run together; only one uncached video is acquired at a time.
TASK_CONCURRENCY=3
# Shared knowledge base. Credentials come from the local host-token provider and stay in process memory.
# Empty URL disables integration; register profile agent-bubble before enabling.
MEMORY_BASE_URL=
MEMORY_BASE_PYTHON=
MEMORY_BASE_HOME=
# Local CPU transcription when platform subtitles are unavailable. Prepare with scripts/setup-asr.ps1.
ASR_ENABLED=true
# Omit ASR_PROVIDER to select Qwen when DASHSCOPE_API_KEY is present, otherwise local.
# Set local to keep using CPU transcription; set qwen for cloud transcription.
# ASR_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_ASR_POLL_MS=2000
ASR_PYTHON_COMMAND=
ASR_MODEL_DIR=.tools/asr-models/small
ASR_CPU_THREADS=8
# Applies to initial video acquisition; cached-source follow-ups retain the ordinary task timeout.
VIDEO_MAX_RUN_MS=1800000
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_MAX_AUDIO_MB=100
# Browser fallback for articles; use chromium after `npx playwright install chromium` on servers.
ARTICLE_BROWSER_ENABLED=true
ARTICLE_BROWSER_CHANNEL=chrome
ARTICLE_BROWSER_HEADLESS=true
ARTICLE_BROWSER_TIMEOUT_MS=60000
# Defaults to DATA_DIR/article-browser. This directory may contain site session cookies.
ARTICLE_BROWSER_PROFILE=
# Zhihu uses an isolated Electron session; other sites retain the Playwright reader.
ARTICLE_BROWSER_ZHIHU_ENGINE=electron
ARTICLE_ELECTRON_PROFILE=
# Optional absolute executable path; normally resolved from the electron npm package.
ARTICLE_ELECTRON_EXECUTABLE=
